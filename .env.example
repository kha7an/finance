# Copy to .env and fill the values you need.

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_ALLOWED_USER_IDS=123456789

# LLM provider: openai | gemini | mock (mock — только явный dev без реального LLM)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-5-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local files
# Docker Compose does not publish Postgres to the host by default.
# App containers connect via postgres:5432 (see docker-compose.yml).
# For host-side Python, publish a DB port explicitly or run CLI through docker compose.
DATABASE_URL=postgresql://budget_bot:budget_bot@127.0.0.1:5433/budget_bot
# Docker Compose overrides DATABASE_URL for app containers to:
# postgresql://budget_bot:budget_bot@postgres:5432/budget_bot
BUDGET_EXPORT_DIR=./data/exports

# Behavior
DEFAULT_TIMEZONE=Europe/Moscow

# Logging: INFO | DEBUG; text (readable) | json (structured)
LOG_LEVEL=INFO
LOG_FORMAT=text
